{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "WCKD Control Center",
    "version":  "0.9.6",
    "identifier":  "com.wckd.controlcenter",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "WCKD Control Center",
                                    "width":  1440,
                                    "height":  900,
                                    "minWidth":  1050,
                                    "minHeight":  700,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [

                            ]
               }
}